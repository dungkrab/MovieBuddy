# ===== ใช้ร่วมทุกแบบ =====
# สุ่มค่ายาว ≥ 32 ตัว: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_KEY=
TMDB_ACCESS_TOKEN=

# ===== เลือกส่วนที่รันในเครื่อง (docker compose --profile) =====
# local-db   = Postgres ในเครื่อง          → ใช้ RDS ให้เอาออก
# local-auth = ตัวจำลอง Cognito (เทสต์ local) → ใช้ Cognito จริงให้เอาออก
# edge       = Caddy + HTTPS (production บน EC2)
COMPOSE_PROFILES=local-db,local-auth

# ===== ล็อกอิน: Amazon Cognito =====
# Local: ไม่ต้องตั้งอะไรเพิ่ม (COGNITO_ENDPOINT ชี้ไป cognito-local และ auth สร้าง user pool ให้เองตอนสตาร์ท)
#        รหัส SMS ยืนยันเบอร์ดูได้จาก:  docker compose logs -f cognito-local
# AWS จริง: ตั้งค่า 3 ตัวนี้ และตั้ง COGNITO_ENDPOINT= ให้ว่างไว้ (บรรทัดต้องมีอยู่ ไม่ใช่ลบทิ้ง)
# COGNITO_ENDPOINT=
# AWS_REGION=ap-southeast-1
# COGNITO_USER_POOL_ID=ap-southeast-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# คุกกี้ล็อกอินเป็น Secure เมื่อ NODE_ENV=production; ถ้าทดสอบ production image ผ่าน http ธรรมดาให้ตั้ง COOKIE_SECURE=false
# COOKIE_SECURE=

# ===== ฐานข้อมูล =====
# ไม่ตั้ง = ใช้ Postgres ใน docker compose (movie:movie@db) | ตั้งแล้ว = ชี้ไป AWS RDS (หนึ่งตัวแปรต่อหนึ่ง service/database)
# sslmode=require เข้ารหัสการเชื่อมต่อ; connection_limit กันใช้ connection เกิน (RDS เล็กมี max_connections จำกัด; รวม = 5 × 5 service)
# รหัสผ่านที่มีอักขระพิเศษต้อง URL-encode (เช่น @ → %40)
# DB_LOCATION=postgresql://location_app:<pw>@<rds-endpoint>:5432/location?sslmode=require&connection_limit=5
# DB_CINEMA=postgresql://cinema_app:<pw>@<rds-endpoint>:5432/cinema?sslmode=require&connection_limit=5
# DB_GROUPS=postgresql://groups_app:<pw>@<rds-endpoint>:5432/groups?sslmode=require&connection_limit=5
# DB_AUTH=postgresql://auth_app:<pw>@<rds-endpoint>:5432/auth?sslmode=require&connection_limit=5
# DB_CHAT=postgresql://chat_app:<pw>@<rds-endpoint>:5432/chat?sslmode=require&connection_limit=5

# ===== แปลงพิกัด GPS → จังหวัด/เขต (location service) =====
# Nominatim สาธารณะ: จำกัด 1 req/วินาที ห้ามใช้หนัก และต้องระบุ User-Agent ที่ติดต่อเจ้าของแอปได้
# ตอน production ให้ตั้ง NOMINATIM_URL เป็น instance ที่โฮสต์เอง
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEOCODER_USER_AGENT=MovieBuddy/1.0 (you@example.com)

# ===== หน้าบ้าน HTTPS (profile edge) =====
# SITE_ADDRESS=movie.example.com
